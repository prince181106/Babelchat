{
  "name": "babelchat",
  "version": "1.0.0",
  "description": "Real-time multilingual chat application",
  "private": true,
  "scripts": {
    "dev": "cd chat-frontend && npm run dev",
    "build": "cd chat-frontend && npm run build",
    "preview": "cd chat-frontend && npm run preview",
    "backend:dev": "cd realtime-chat-backend && npm run dev",
    "backend:start": "cd realtime-chat-backend && npm start",
    "dev:full": "concurrently \"npm run dev\" \"npm run backend:dev\"",
    "install-all": "npm install && cd chat-frontend && npm install && cd ../realtime-chat-backend && npm install && cd .."
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "vite": "^7.3.1"
  }
}
